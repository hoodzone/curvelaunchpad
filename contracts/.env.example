# --- Robinhood Chain deployment ---

# Mainnet (chainId 4663). The public endpoint is rate-limited; for production use
# a dedicated provider (Alchemy, QuickNode, dRPC, Blockdaemon, Validation Cloud).
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Testnet (adjust chainId/URL to the current public testnet if you deploy there).
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_TESTNET_CHAIN_ID=46630

# Deployer key (funded with ETH on Robinhood Chain). NEVER commit a real key.
DEPLOYER_PRIVATE_KEY=

# --- Launchpad parameters (used by scripts/deploy.ts) ---

# Address that receives platform fees. Defaults to the deployer if empty.
FEE_RECIPIENT=
# Platform trade fee in basis points (100 = 1%). Max 1000 (10%).
FEE_BPS=100
# Default ETH a token must raise on the curve before it graduates to the DEX.
# Expressed in ETH; must be >= a few wei. 4 => start mcap ~2 ETH, grad mcap ~50 ETH.
DEFAULT_TARGET_RAISE_ETH=4
# Optional: Uniswap V2-style router on Robinhood Chain. Leave empty until known;
# graduation will halt trading and wait for the owner to set the router later.
DEX_ROUTER=

# --- Robinhood Chain (client-visible) ---
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_CHAIN_NAME=Robinhood Chain
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com
NEXT_PUBLIC_CURRENCY_SYMBOL=ETH

# --- Deployed Launchpad (fill in after `pnpm --dir contracts deploy:robinhood`) ---
NEXT_PUBLIC_LAUNCHPAD_ADDRESS=0x0000000000000000000000000000000000000000
# Block the launchpad was deployed at — bounds the event log scan for the indexer.
NEXT_PUBLIC_LAUNCHPAD_DEPLOY_BLOCK=0

# --- Server-side RPC (optional; falls back to NEXT_PUBLIC_RPC_URL) ---
# Use a dedicated provider endpoint here to avoid rate limits on the API routes.
RPC_URL=
